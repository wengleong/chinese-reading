DATABASE_URL=postgresql://user:pass@host:5432/dbname
DATABASE_SSL=true
JWT_SECRET=change-me-to-a-long-random-string
# Powers every AI feature (oral scoring, reading feedback, story generation,
# 听写 grading). Set it in Railway Variables — it must never reach the browser.
ANTHROPIC_API_KEY=sk-ant-...
PORT=3001
ALLOWED_ORIGIN=https://yourusername.github.io
